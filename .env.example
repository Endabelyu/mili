# URL of the backend API — MUST include protocol (https:// or http://)
VITE_API_URL=https://finance-api.endabelyu.com

# Sentry error tracking (optional — leave blank to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_RATE=0.1
VITE_APP_VERSION=1.0.0
