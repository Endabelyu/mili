# =============================================================================
# personal-finance-tracker-web — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own values.
# Only VITE_* variables are exposed to the browser bundle.
# Never commit the real .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API (Required)
# URL of the backend Hono server — MUST include protocol (https:// or http://)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3005

# -----------------------------------------------------------------------------
# Error Tracking — Sentry (Optional)
# Leave VITE_SENTRY_DSN blank to disable client-side error tracking
# https://docs.sentry.io/platforms/javascript/guides/react/
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=
# Fraction of transactions to trace (0.0–1.0). Defaults to 0.1 if not set.
VITE_SENTRY_TRACES_RATE=0.1
# Injected at build time — should match your package.json version (e.g. 1.0.0)
VITE_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Analytics — PostHog (Optional)
# Leave VITE_POSTHOG_KEY blank to disable analytics and session recording
# https://posthog.com/docs/libraries/js
# -----------------------------------------------------------------------------
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
